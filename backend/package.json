{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ReachInbox email job scheduler with PostgreSQL/BullMQ and SQLite/local delivery modes",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "postinstall": "node scripts/prisma-generate.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "seed:senders": "tsx scripts/seed-senders.ts",
    "prisma:generate": "node scripts/prisma-generate.mjs",
    "db:local": "prisma db push --schema prisma/schema.sqlite.prisma --skip-generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:load": "tsx scripts/load-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx scripts/seed-senders.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bullmq": "^5.41.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
